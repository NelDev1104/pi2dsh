{
  "schemaVersion": 1,
  "baseline": {
    "pi": "0.84.1",
    "dsh": "0.1.0-rc.6"
  },
  "piCapabilityContracts": [
    {
      "id": "pi.tools.registry",
      "area": "tools",
      "title": "Tool registry and visibility",
      "titleZh": "工具注册与可见性",
      "surfaces": ["pi.*:registerTool", "pi.*:unregisterTool", "pi.*:getActiveTools", "pi.*:getAllTools", "pi.*:setActiveTools"]
    },
    {
      "id": "pi.tools.lifecycle",
      "area": "tools",
      "title": "Tool execution lifecycle",
      "titleZh": "工具执行生命周期",
      "surfaces": ["event:tool_execution_start", "event:tool_execution_end", "event:tool_execution_update", "event:tool_call", "event:tool_result"]
    },
    {
      "id": "pi.tools.process-execution",
      "area": "tools",
      "title": "Process execution",
      "titleZh": "进程执行",
      "surfaces": ["pi.*:exec", "event:user_bash"]
    },
    {
      "id": "pi.commands.registry",
      "area": "commands",
      "title": "Command registry",
      "titleZh": "命令注册",
      "surfaces": ["pi.*:registerCommand", "pi.*:getCommands"]
    },
    {
      "id": "pi.commands.controls",
      "area": "commands",
      "title": "Flags and shortcuts",
      "titleZh": "Flag 与快捷键",
      "surfaces": ["pi.*:registerShortcut", "pi.*:registerFlag", "pi.*:getFlag"]
    },
    {
      "id": "pi.input.preprocess",
      "area": "commands",
      "title": "User input preprocessing",
      "titleZh": "用户输入预处理",
      "surfaces": ["event:input"]
    },
    {
      "id": "pi.messages.injection",
      "area": "conversation",
      "title": "Message injection",
      "titleZh": "消息注入",
      "surfaces": ["pi.*:sendMessage", "pi.*:sendUserMessage"]
    },
    {
      "id": "pi.messages.lifecycle",
      "area": "conversation",
      "title": "Message and context lifecycle",
      "titleZh": "消息与上下文生命周期",
      "surfaces": ["event:message_start", "event:message_end", "event:message_update", "event:context"]
    },
    {
      "id": "pi.agent.lifecycle",
      "area": "conversation",
      "title": "Agent and turn lifecycle",
      "titleZh": "Agent 与轮次生命周期",
      "surfaces": ["event:before_agent_start", "event:agent_start", "event:agent_settled", "event:agent_end", "event:turn_start", "event:turn_end"]
    },
    {
      "id": "pi.agent.control",
      "area": "conversation",
      "title": "Agent control and idleness",
      "titleZh": "Agent 控制与空闲状态",
      "surfaces": ["ctx.*:isIdle", "ctx.*:hasPendingMessages", "ctx.*:waitForIdle", "ctx.*:abort", "ctx.*:signal"]
    },
    {
      "id": "pi.prompt.context",
      "area": "conversation",
      "title": "Prompt and context inspection",
      "titleZh": "提示词与上下文检查",
      "surfaces": ["ctx.*:getContextUsage", "ctx.*:getSystemPrompt", "ctx.*:getSystemPromptOptions"]
    },
    {
      "id": "pi.sessions.metadata",
      "area": "sessions",
      "title": "Session facts and metadata",
      "titleZh": "会话事实与元数据",
      "surfaces": ["pi.*:appendEntry", "pi.*:setSessionName", "pi.*:getSessionName", "pi.*:setLabel", "event:session_start", "event:session_shutdown", "event:session_info_changed"]
    },
    {
      "id": "pi.sessions.navigation",
      "area": "sessions",
      "title": "Session creation, forks and navigation",
      "titleZh": "会话创建、分支与导航",
      "surfaces": ["ctx.*:newSession", "ctx.*:fork", "ctx.*:navigateTree", "ctx.*:switchSession", "event:session_before_switch", "event:session_before_fork", "event:session_before_tree", "event:session_tree"]
    },
    {
      "id": "pi.sessions.compaction",
      "area": "sessions",
      "title": "Session compaction",
      "titleZh": "会话压缩",
      "surfaces": ["ctx.*:compact", "event:session_before_compact", "event:session_compact"]
    },
    {
      "id": "pi.sessions.host-context",
      "area": "sessions",
      "title": "Session host context and reload",
      "titleZh": "会话宿主上下文与重载",
      "surfaces": ["ctx.*:sessionManager", "ctx.*:cwd", "ctx.*:mode", "ctx.*:shutdown", "ctx.*:reload"]
    },
    {
      "id": "pi.models.providers",
      "area": "models",
      "title": "Provider and model registry",
      "titleZh": "Provider 与模型目录",
      "surfaces": ["pi.*:registerProvider", "pi.*:unregisterProvider", "ctx.*:modelRegistry", "ctx.*:model", "ctx.*:scopedModels", "ctx.*:hasConfiguredAuth"]
    },
    {
      "id": "pi.models.selection",
      "area": "models",
      "title": "Model and reasoning selection",
      "titleZh": "模型与推理档位选择",
      "surfaces": ["pi.*:setModel", "pi.*:getThinkingLevel", "pi.*:setThinkingLevel", "ctx.*:thinkingLevel", "event:model_select", "event:thinking_level_select"]
    },
    {
      "id": "pi.models.wire",
      "area": "models",
      "title": "Provider wire lifecycle",
      "titleZh": "Provider 网络请求生命周期",
      "surfaces": ["event:before_provider_request", "event:before_provider_headers", "event:after_provider_response"]
    },
    {
      "id": "pi.ui.questions",
      "area": "interaction",
      "title": "Blocking user questions",
      "titleZh": "阻塞式用户提问",
      "surfaces": ["ctx.ui.*:select", "ctx.ui.*:confirm", "ctx.ui.*:input", "ctx.ui.*:editor", "ctx.ui.*:custom"]
    },
    {
      "id": "pi.ui.notifications",
      "area": "interaction",
      "title": "Notifications and working state",
      "titleZh": "通知与工作状态",
      "surfaces": ["ctx.ui.*:notify", "ctx.ui.*:setStatus", "ctx.ui.*:setWidget", "ctx.ui.*:setWorkingMessage", "ctx.ui.*:setWorkingVisible", "ctx.ui.*:setWorkingIndicator", "ctx.ui.*:setHiddenThinkingLabel"]
    },
    {
      "id": "pi.ui.chrome",
      "area": "interaction",
      "title": "Host chrome and tool expansion",
      "titleZh": "宿主框架与工具展开状态",
      "surfaces": ["ctx.ui.*:setFooter", "ctx.ui.*:setHeader", "ctx.ui.*:setTitle", "ctx.ui.*:getToolsExpanded", "ctx.ui.*:setToolsExpanded"]
    },
    {
      "id": "pi.ui.editor",
      "area": "interaction",
      "title": "Editor interaction",
      "titleZh": "编辑器交互",
      "surfaces": ["ctx.ui.*:onTerminalInput", "ctx.ui.*:pasteToEditor", "ctx.ui.*:setEditorText", "ctx.ui.*:getEditorText", "ctx.ui.*:addAutocompleteProvider", "ctx.ui.*:setEditorComponent", "ctx.ui.*:getEditorComponent"]
    },
    {
      "id": "pi.ui.rendering",
      "area": "interaction",
      "title": "Message rendering and themes",
      "titleZh": "消息渲染与主题",
      "surfaces": ["pi.*:registerMessageRenderer", "pi.*:registerEntryRenderer", "pi.*:registerMarkdownTransformer", "ctx.*:hasUI", "ctx.ui.*:theme", "ctx.ui.*:getAllThemes", "ctx.ui.*:getTheme", "ctx.ui.*:setTheme"]
    },
    {
      "id": "pi.project.trust",
      "area": "environment",
      "title": "Project trust",
      "titleZh": "项目信任",
      "surfaces": ["ctx.*:isProjectTrusted", "event:project_trust"]
    },
    {
      "id": "pi.resources.discovery",
      "area": "environment",
      "title": "Dynamic resource discovery",
      "titleZh": "动态资源发现",
      "surfaces": ["event:resources_discover"]
    },
    {
      "id": "pi.events.bus",
      "area": "environment",
      "title": "Package event bus",
      "titleZh": "包内事件总线",
      "surfaces": ["pi.*:events"]
    }
  ],
  "dshMechanisms": [
    {
      "id": "dsh.plugin-composition",
      "title": "Plugin composition and policy",
      "titleZh": "插件组合与策略",
      "subsystems": ["core", "extensions", "settings", "scope", "invariants", "permission-presets"],
      "seams": ["Cordis service/provider", "ctx.effect", "ctx.inject", "waterfall", "scope/isolate/intercept"]
    },
    {
      "id": "dsh.agent-session",
      "title": "Durable sessions and context projection",
      "titleZh": "持久会话与上下文投影",
      "subsystems": ["compaction", "persistence", "session-projection", "session-query", "session-reference", "session-telemetry", "session-title", "session", "spill", "storage"],
      "seams": ["ctx.sessions", "Session.append", "durable session events", "compaction", "session projection"]
    },
    {
      "id": "dsh.model-runtime",
      "title": "Model routing, credentials and prompt assembly",
      "titleZh": "模型路由、凭证与提示词装配",
      "subsystems": ["credentials", "llm-streaming", "token-meter", "system-prompt"],
      "seams": ["llm.registerAdapter", "llm/stream", "credentials provider", "system-prompt/assemble", "agent/request"]
    },
    {
      "id": "dsh.execution",
      "title": "Tools, execution and isolation",
      "titleZh": "工具、执行与隔离",
      "subsystems": ["approval", "code-runtime", "filesystem", "sandbox", "shell", "subprocess", "terminal", "tools"],
      "seams": ["ctx.tools", "ctx.exec", "subprocess provider", "sandbox provider", "approval policy"]
    },
    {
      "id": "dsh.resources",
      "title": "Workspace resources",
      "titleZh": "工作区资源",
      "subsystems": ["attachment", "skills", "web", "workspace", "lsp"],
      "seams": ["attachment provider", "skill provider", "web provider", "workspace provider", "lsp provider"]
    },
    {
      "id": "dsh.orchestration",
      "title": "Agent orchestration",
      "titleZh": "Agent 编排",
      "subsystems": ["goal", "jobs", "plan", "schedule", "subagent", "workflow"],
      "seams": ["ctx.agents", "subagent provider", "goal/plan/jobs/workflow providers"]
    },
    {
      "id": "dsh.interaction",
      "title": "Commands and human interaction",
      "titleZh": "命令与人机交互",
      "subsystems": ["commands", "feedback", "user-questions"],
      "seams": ["ctx.commands", "ctx.userQuestions", "feedback provider"]
    },
    {
      "id": "dsh.client",
      "title": "Client and web presentation",
      "titleZh": "客户端与 Web 呈现",
      "subsystems": ["client-modules", "typert", "web-server"],
      "seams": ["client module", "slot registry", "web route", "typert remote surface"]
    }
  ],
  "theoreticalMappings": [
    {"id": "map.tools.registry", "piContract": "pi.tools.registry", "dshMechanisms": ["dsh.execution"], "expectedSeams": ["ctx.tools registry and per-agent visibility"], "theory": "direct"},
    {"id": "map.tools.lifecycle", "piContract": "pi.tools.lifecycle", "dshMechanisms": ["dsh.execution", "dsh.agent-session"], "expectedSeams": ["tool execution lifecycle and durable tool events"], "theory": "composed"},
    {"id": "map.tools.process-execution", "piContract": "pi.tools.process-execution", "dshMechanisms": ["dsh.execution"], "expectedSeams": ["ctx.exec and subprocess provider"], "theory": "direct"},
    {"id": "map.commands.registry", "piContract": "pi.commands.registry", "dshMechanisms": ["dsh.interaction"], "expectedSeams": ["ctx.commands registry"], "theory": "direct"},
    {"id": "map.commands.controls", "piContract": "pi.commands.controls", "dshMechanisms": ["dsh.interaction", "dsh.client"], "expectedSeams": ["command descriptors and client input bindings"], "theory": "composed"},
    {"id": "map.input.preprocess", "piContract": "pi.input.preprocess", "dshMechanisms": ["dsh.plugin-composition", "dsh.agent-session"], "expectedSeams": ["agent/pre-step before input becomes a durable step"], "theory": "direct"},
    {"id": "map.messages.injection", "piContract": "pi.messages.injection", "dshMechanisms": ["dsh.agent-session", "dsh.plugin-composition"], "expectedSeams": ["agent/pre-step and native session message append"], "theory": "composed"},
    {"id": "map.messages.lifecycle", "piContract": "pi.messages.lifecycle", "dshMechanisms": ["dsh.agent-session", "dsh.model-runtime"], "expectedSeams": ["llm stream and pre-commit/durable message lifecycle"], "theory": "composed"},
    {"id": "map.agent.lifecycle", "piContract": "pi.agent.lifecycle", "dshMechanisms": ["dsh.plugin-composition", "dsh.agent-session"], "expectedSeams": ["agent waterfalls and durable turn/step events"], "theory": "composed"},
    {"id": "map.agent.control", "piContract": "pi.agent.control", "dshMechanisms": ["dsh.plugin-composition", "dsh.orchestration"], "expectedSeams": ["agent queue, cancellation signal and lifecycle"], "theory": "composed"},
    {"id": "map.prompt.context", "piContract": "pi.prompt.context", "dshMechanisms": ["dsh.model-runtime", "dsh.agent-session"], "expectedSeams": ["system-prompt/assemble, token-meter and session projection"], "theory": "composed"},
    {"id": "map.sessions.metadata", "piContract": "pi.sessions.metadata", "dshMechanisms": ["dsh.agent-session", "dsh.client"], "expectedSeams": ["namespaced durable session facts and native projection"], "theory": "missing-seam"},
    {"id": "map.sessions.navigation", "piContract": "pi.sessions.navigation", "dshMechanisms": ["dsh.agent-session", "dsh.orchestration"], "expectedSeams": ["ctx.sessions create/fork and host-wide navigation lifecycle"], "theory": "composed"},
    {"id": "map.sessions.compaction", "piContract": "pi.sessions.compaction", "dshMechanisms": ["dsh.agent-session", "dsh.plugin-composition"], "expectedSeams": ["pre-compaction decision waterfall plus durable result events"], "theory": "missing-seam"},
    {"id": "map.sessions.host-context", "piContract": "pi.sessions.host-context", "dshMechanisms": ["dsh.agent-session", "dsh.plugin-composition"], "expectedSeams": ["session service, workspace scope and Cordis reload"], "theory": "composed"},
    {"id": "map.models.providers", "piContract": "pi.models.providers", "dshMechanisms": ["dsh.model-runtime", "dsh.plugin-composition"], "expectedSeams": ["llm catalog, llm.registerAdapter, credentials and settings"], "theory": "composed"},
    {"id": "map.models.selection", "piContract": "pi.models.selection", "dshMechanisms": ["dsh.model-runtime", "dsh.client"], "expectedSeams": ["authoritative model catalog and request-level reasoning options"], "theory": "composed"},
    {"id": "map.models.wire", "piContract": "pi.models.wire", "dshMechanisms": ["dsh.model-runtime", "dsh.plugin-composition"], "expectedSeams": ["adapter transport request/response middleware"], "theory": "missing-seam"},
    {"id": "map.ui.questions", "piContract": "pi.ui.questions", "dshMechanisms": ["dsh.interaction", "dsh.client"], "expectedSeams": ["ctx.userQuestions with native client rendering"], "theory": "composed"},
    {"id": "map.ui.notifications", "piContract": "pi.ui.notifications", "dshMechanisms": ["dsh.client"], "expectedSeams": ["client module and shell slots"], "theory": "composed"},
    {"id": "map.ui.chrome", "piContract": "pi.ui.chrome", "dshMechanisms": ["dsh.client"], "expectedSeams": ["client slot registry and host-owned presentation state"], "theory": "composed"},
    {"id": "map.ui.editor", "piContract": "pi.ui.editor", "dshMechanisms": ["dsh.client", "dsh.interaction"], "expectedSeams": ["client editor slots and command/input bridge"], "theory": "host-translation"},
    {"id": "map.ui.rendering", "piContract": "pi.ui.rendering", "dshMechanisms": ["dsh.client"], "expectedSeams": ["Web-native client modules and slots"], "theory": "host-translation"},
    {"id": "map.project.trust", "piContract": "pi.project.trust", "dshMechanisms": ["dsh.plugin-composition", "dsh.resources"], "expectedSeams": ["host-owned trust policy before project resource loading"], "theory": "missing-seam"},
    {"id": "map.resources.discovery", "piContract": "pi.resources.discovery", "dshMechanisms": ["dsh.resources", "dsh.plugin-composition"], "expectedSeams": ["lifecycle-bound skill/MCP/resource providers"], "theory": "composed"},
    {"id": "map.events.bus", "piContract": "pi.events.bus", "dshMechanisms": ["dsh.plugin-composition"], "expectedSeams": ["package-scoped event bus disposed with the plugin fiber"], "theory": "direct"}
  ],
  "bridgeDebts": [
    {
      "id": "PI2DSH-DEBT-001",
      "mapping": "map.resources.discovery",
      "summary": "Translate Pi resources_discover results into lifecycle-bound DSH resource providers."
    },
    {
      "id": "PI2DSH-DEBT-002",
      "mapping": "map.prompt.context",
      "summary": "Project DSH token-meter and model-window data into Pi getContextUsage()."
    },
    {
      "id": "PI2DSH-DEBT-003",
      "mapping": "map.input.preprocess",
      "summary": "Run Pi input preprocessing on DSH agent/pre-step before the user message enters a step."
    },
    {
      "id": "PI2DSH-DEBT-004",
      "mapping": "map.sessions.navigation",
      "summary": "Observe host-UI initiated session switch/fork/tree operations, not only bridge-initiated operations."
    }
  ],
  "dshGaps": [
    {
      "id": "DSH-ARCH-001",
      "mapping": "map.sessions.metadata",
      "summary": "Out-of-repo plugins cannot append namespaced custom session facts that remain safe to replay.",
      "evidence": ["scripts/verify-out-of-repo-event-type.mjs", "docs/dsh-architecture-audit.md"]
    },
    {
      "id": "DSH-ARCH-002",
      "mapping": "map.models.providers",
      "summary": "Configured providers cannot carry the full wire-compat schema into the official adapter.",
      "evidence": ["examples/gateway-compat", "docs/dsh-architecture-audit.md"]
    },
    {
      "id": "DSH-ARCH-003",
      "mapping": "map.models.wire",
      "summary": "Existing model adapters expose no general middleware around the final request and raw response.",
      "evidence": ["docs/capabilities/models.md", "docs/dsh-architecture-audit.md"]
    },
    {
      "id": "DSH-ARCH-004",
      "mapping": "map.sessions.compaction",
      "summary": "Compaction has durable fact events but no pre-decision cancel/replace waterfall.",
      "evidence": ["docs/capabilities/sessions.md", "docs/dsh-architecture-audit.md"]
    },
    {
      "id": "DSH-ARCH-005",
      "mapping": "map.project.trust",
      "summary": "No out-of-repo trust policy seam runs before project resources are loaded.",
      "evidence": ["docs/capabilities/environment.md", "docs/dsh-architecture-audit.md"]
    }
  ],
  "pendingClassifications": [
    {
      "mapping": "map.messages.lifecycle",
      "summary": "Determine whether message_end replacement can preserve stream, log and UI consistency through public seams."
    },
    {
      "mapping": "map.tools.lifecycle",
      "summary": "Determine whether DSH-native tools expose a composable partial-result update channel."
    },
    {
      "mapping": "map.ui.rendering",
      "summary": "Separate portable presentation intent from Pi terminal-only component implementation."
    }
  ],
  "validations": [
    {
      "id": "validation.pi-btw",
      "plugin": "pi-btw",
      "scenario": "Run a side conversation without putting its answer in the main thread",
      "results": [
        {"mapping": "map.commands.registry", "grade": 1},
        {"mapping": "map.sessions.navigation", "grade": 1},
        {"mapping": "map.ui.chrome", "grade": 2},
        {"mapping": "map.sessions.metadata", "grade": 3}
      ],
      "evidence": ["examples/side-conversation", "scripts/verify-examples-e2e.mjs"]
    },
    {
      "id": "validation.pi-vision",
      "plugin": "@kassing/pi-vision",
      "scenario": "Analyze an attached image and inject the result into a text-model turn",
      "results": [
        {"mapping": "map.agent.lifecycle", "grade": 2},
        {"mapping": "map.models.providers", "grade": 2},
        {"mapping": "map.messages.injection", "grade": 2}
      ],
      "evidence": ["examples/vision-bridge", "scripts/verify-examples-e2e.mjs"]
    },
    {
      "id": "validation.provider-gateway",
      "plugin": "pi-provider-litellm",
      "scenario": "Use a transport-owning Pi provider as a native DSH model route",
      "results": [
        {"mapping": "map.models.providers", "grade": 1},
        {"mapping": "map.models.selection", "grade": 2}
      ],
      "evidence": ["examples/gateway-compat", "scripts/verify-community-scenarios.mjs"]
    },
    {
      "id": "validation.oauth-codex",
      "plugin": "built-in Pi openai-codex provider flow",
      "scenario": "Log in with a subscription and call the selected model through DSH",
      "results": [
        {"mapping": "map.models.providers", "grade": 2},
        {"mapping": "map.models.selection", "grade": 2},
        {"mapping": "map.ui.questions", "grade": 2}
      ],
      "evidence": ["examples/subscription-login", "scripts/verify-oauth-llm-e2e.mjs"]
    }
  ]
}
